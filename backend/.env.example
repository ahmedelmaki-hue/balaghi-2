PORT=5000
# Copy the connection string from Supabase > Connect. This is a server-only secret.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
SUPABASE_STORAGE_BUCKET=report-images
# Domain for internal staff Auth emails (username@domain). Staff never see or type it.
STAFF_EMAIL_DOMAIN=balaghi.local
# Comma-separated browser origins. Leave empty for local development only.
CORS_ORIGINS=http://localhost:5173
# Behind a reverse proxy (nginx, a hosting platform): 1 = trust one proxy hop.
# Leave empty when the API is reached directly.
TRUST_PROXY=
# Sign-in codes by SMS through Resala (resala.ly), via Supabase's Send SMS hook.
# Set all three or none. The template must be approved in Resala and contain $1 for the code.
RESALA_API_KEY=
RESALA_TEMPLATE_ID=
# Shown when the hook is created in Supabase > Authentication > Hooks (starts with v1,whsec_).
SMS_HOOK_SECRET=
# Optional: a registered sender name, exactly as in Resala (case-sensitive).
RESALA_SENDER=
# true = Resala sandbox: nothing is sent or charged. Remove for real messages.
RESALA_TEST=true
# Street names from OpenStreetMap. off = keep coordinates only.
GEOCODER=
# Automatic photo check with Claude (a suggestion for staff). Empty key = no check.
# Create the key at console.anthropic.com; keep it in Render's environment, never in git.
ANTHROPIC_API_KEY=
# off = keep the key but stop checking. The model defaults to claude-haiku-5-5.
PHOTO_CHECK=
PHOTO_CHECK_MODEL=
