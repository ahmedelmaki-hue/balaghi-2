{
  "name": "balaghi-backend",
  "version": "0.1.0",
  "description": "Balaghi API - Node + Express + PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:local": "node --watch --require ./scripts/local-env.js src/server.js",
    "configure:local": "node scripts/configure-local-env.js",
    "usage:local": "node scripts/local-usage.js",
    "migrate:field:local": "node --require ./scripts/local-env.js scripts/migrate-local-field-assignments.js",
    "migrate:field-review:local": "node --require ./scripts/local-env.js scripts/migrate-local-field-issue-reviews.js",
    "migrate:agency:local": "node --require ./scripts/local-env.js scripts/migrate-local-work-agencies.js",
    "migrate:verification:local": "node --require ./scripts/local-env.js scripts/migrate-local-preapproval-verifications.js",
    "migrate:auto-assignment:local": "node --require ./scripts/local-env.js scripts/migrate-local-auto-assignment.js",
    "migrate:completion:local": "node --require ./scripts/local-env.js scripts/migrate-local-work-completion.js",
    "migrate:completion-photo:local": "node --require ./scripts/local-env.js scripts/migrate-local-completion-evidence.js",
    "migrate:admin:local": "node --require ./scripts/local-env.js scripts/migrate-local-admin.js",
    "migrate:field-decisions:local": "node --require ./scripts/local-env.js scripts/migrate-local-field-review-decisions.js",
    "worker:create:local": "node --require ./scripts/local-env.js scripts/create-local-field-worker.js",
    "admin:create": "node --require dotenv/config scripts/create-admin.js",
    "admin:create:local": "node --require ./scripts/local-env.js scripts/create-admin.js",
    "supabase:start:local": "node scripts/local-supabase.js start",
    "supabase:stop:local": "node scripts/local-supabase.js stop",
    "start": "node src/server.js",
    "start:local": "node --require ./scripts/local-env.js src/server.js",
    "test": "node --test",
    "test:integration": "node --require ./scripts/local-env.js --test integration/lifecycle.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.5",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "supabase": "^2.121.0"
  }
}
